# Copie este arquivo para .env e ajuste os valores.
# O .env nunca deve ir para o GitHub (RNF-29).

# Chave usada para assinar os cookies de sessão. Em produção, gere uma com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados. Sem esta variável, o desenvolvimento usa SQLite (instance/dev.db).
# Postgres local:   postgresql://usuario:senha@localhost:5432/constelacao
# Supabase:         copie a string do "Session pooler" no botão "Connect" do projeto
# DATABASE_URL=

# Em produção (HTTPS) deve ser 1, para o cookie de sessão só trafegar por HTTPS (RNF-11).
SESSION_COOKIE_SECURE=0
